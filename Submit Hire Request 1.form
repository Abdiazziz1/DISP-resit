{
    "executionPlatform": "Camunda Cloud",
    "executionPlatformVersion": "8.8.0",
    "exporter": {
        "name": "Camunda Web Modeler",
        "version": "116eb56"
    },
    "schemaVersion": 19,
    "id": "submit-hire-request",
    "components": [
        {
            "type": "textfield",
            "label": "Customer name",
            "key": "customerName",
            "validate": {
                "required": true,
                "minLength": 2,
                "maxLength": 100
            }
        },
        {
            "type": "textfield",
            "label": "Tool ID",
            "key": "toolId",
            "validate": {
                "required": true,
                "pattern": "^[A-Za-z0-9-]{3,20}$"
            },
            "errorMessage": {
                "pattern": "Tool ID must be 3-20 letters, numbers or hyphens"
            }
        },
        {
            "type": "datetime",
            "subtype": "date",
            "label": "Hire start date",
            "key": "hireStartDate",
            "validate": {
                "required": true
            }
        },
        {
            "type": "number",
            "label": "Hire length in days",
            "key": "hireDays",
            "validate": {
                "required": true,
                "min": 1,
                "max": 30
            }
        }
    ],
    "type": "default"
}
